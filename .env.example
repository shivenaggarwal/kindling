# ── Core ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kindling
# Password for signing in to the Kindling dashboard
APP_PASSWORD=change-me
# 32+ random characters. Signs sessions and encrypts stored Google tokens.
# Generate with: openssl rand -hex 32
APP_SECRET=
# Where the app is reachable (used for the Google OAuth redirect)
APP_URL=http://localhost:3000

# ── AI (one of these is required) ───────────────────────────────────────
# AI_PROVIDER picks the model when both keys are set: gemini | anthropic
AI_PROVIDER=
# Gemini: an AI Studio key (AIza…) or a Vertex AI express-mode key (AQ.…); the type is detected
GEMINI_API_KEY=
# Optional: primary model, and fallbacks used when it's overloaded
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-pro-preview
ANTHROPIC_API_KEY=

# ── Lead sources (each optional; Kindling uses whichever keys are set) ──
APOLLO_API_KEY=
HUNTER_API_KEY=
GOOGLE_PLACES_API_KEY=

# ── Gmail + Google Calendar (OAuth client, type "Web application") ─────
# Authorized redirect URI: ${APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cost tracking (USD per unit, used for cost-per-lead analytics) ──────
COST_APOLLO_CREDIT=0.025
COST_HUNTER_REQUEST=0.0165
COST_PLACES_REQUEST=0.035

# ── Hosting (Vercel) ────────────────────────────────────────────────────
# Authenticates the scheduler endpoint /api/cron/tick (Vercel Cron / GitHub Actions)
CRON_SECRET=
# Set to 1 to run background jobs inside the web process instead of a worker
# (automatic on Vercel).
INLINE_JOBS=

# ── High-volume sending (Instantly) ─────────────────────────────────────
# API key with scope all:all. Enables pre-warmed mailboxes, warm-up and rotation.
INSTANTLY_API_KEY=
