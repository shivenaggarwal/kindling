# ── Core ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kindling
# Password for signing in to the Kindling dashboard
APP_PASSWORD=change-me
# 32+ random characters. Signs sessions and encrypts stored Google tokens.
# Generate with: openssl rand -hex 32
APP_SECRET=
# Where the app is reachable (used for the Google OAuth redirect)
APP_URL=http://localhost:3000

# ── AI (required) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Lead sources (each optional; Kindling uses whichever keys are set) ──
APOLLO_API_KEY=
HUNTER_API_KEY=
GOOGLE_PLACES_API_KEY=

# ── Gmail + Google Calendar (OAuth client, type "Web application") ─────
# Authorized redirect URI: ${APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cost tracking (USD per unit, used for cost-per-lead analytics) ──────
COST_APOLLO_CREDIT=0.025
COST_HUNTER_REQUEST=0.0165
COST_PLACES_REQUEST=0.035
